<!-- Add inside system.core0 (before BTB) to model I-Fuse. Table geometry
     defaults match Scarab hpca2027-revision-ifuse; any <table>_<field> param
     below overrides the default. Stats come from Scarab's ifuse.stat
     (see scripts/ifuse_power/run_ifuse_power.py). -->
<param name="number_of_ifuse" value="1"/>
<component id="system.core0.IFuse" name="IFuse">
	<param name="enabled" value="1"/>
	<!-- fct, apt, aci, tt, rlb: sets, ways, tag_bits, data_bits,
	     repl_bits_per_set, rd_ports, wr_ports -->
	<param name="fct_sets" value="128"/>
	<param name="fct_ways" value="4"/>
	<param name="fct_rd_ports" value="6"/>
	<stat name="fct_read_accesses" value="3761652"/>
	<stat name="fct_write_accesses" value="2002788"/>
	<stat name="apt_read_accesses" value="7766937"/>
	<stat name="apt_write_accesses" value="6190300"/>
	<stat name="aci_read_accesses" value="2002678"/>
	<stat name="aci_write_accesses" value="2093811"/>
	<stat name="tt_read_accesses" value="245378"/>
	<stat name="tt_write_accesses" value="431548"/>
	<stat name="rlb_read_accesses" value="9801426"/>
	<stat name="rlb_write_accesses" value="5764330"/>
</component>
