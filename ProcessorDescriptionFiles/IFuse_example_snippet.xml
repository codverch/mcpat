<!-- Add inside system.core0 (after BTB) to enable runtime I-Fuse power modeling.
     training_insert_threshold is a promotion policy knob only; the modeled TT
     observation counter is always 14 bits wide regardless of threshold. -->
<param name="number_of_ifuse" value="1"/>
<component id="system.core0.IFuse" name="IFuse">
	<param name="enabled" value="1"/>
	<param name="pc_tag_bits" value="32"/>
	<param name="rlb_entries" value="512"/>
	<param name="fct_entries" value="512"/>
	<param name="training_table_sets" value="32"/>
	<param name="training_table_ways" value="4"/>
	<param name="training_insert_threshold" value="1000"/>
	<param name="training_table_block_tag_bits" value="20"/>
	<param name="training_observation_counter_bits" value="14"/>
	<param name="apt_sets" value="64"/>
	<param name="apt_ways" value="4"/>
	<param name="aci_sets" value="64"/>
	<param name="aci_ways" value="4"/>
	<!-- Runtime stats from Scarab (see power_scarab_config IFuse block). -->
	<stat name="rlb_read_accesses" value="800000"/>
	<stat name="rlb_write_accesses" value="800000"/>
	<stat name="fct_read_accesses" value="800000"/>
	<stat name="fct_write_accesses" value="2000"/>
	<stat name="tt_read_accesses" value="50000"/>
	<stat name="tt_write_accesses" value="50000"/>
	<stat name="apt_read_accesses" value="800000"/>
	<stat name="apt_write_accesses" value="80000"/>
	<stat name="aci_read_accesses" value="800000"/>
	<stat name="aci_write_accesses" value="80000"/>
</component>
